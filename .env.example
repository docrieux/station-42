# Copy to .env and fill in.  .env is gitignored — never commit real values.
# `just` and `docker compose` both load .env automatically.

# ---- Timezone ---------------------------------------------------------------
TZ=America/Santiago

# ---- DuckDNS + HTTPS ------------------------------------------------------
# Register a free subdomain at https://www.duckdns.org (sign in, pick a name).
# DUCKDNS_DOMAIN is the full host, e.g. station42.duckdns.org
DUCKDNS_DOMAIN=station42.duckdns.org
# The token shown on the DuckDNS dashboard (one token for your whole account).
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000
# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# ---- Pi-hole --------------------------------------------------------------
PIHOLE_PASSWORD=change-me

# ---- App defaults ------------------------------------------------------
LOG_LEVEL=INFO

# wordbook: optional rae-api.com key (free tier works without one).
# WORDBOOK_RAE_API_KEY=
