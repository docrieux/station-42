# Secrets / local config
.env
*.local

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Runtime data written by containers (bind mounts)
**/data/
!**/data/.gitkeep

# Backups
backups/

# Caddy cert/config storage
infra/caddy/data/
infra/caddy/config/

# Local-testing Caddy state (internal CA) -- see docs/local-testing.md
infra/caddy/data-local/
infra/caddy/config-local/
# ...but the local Caddyfile is tracked (the `*.local` rule above would hide it)
!infra/caddy/Caddyfile.local

# OS
.DS_Store
Thumbs.db
